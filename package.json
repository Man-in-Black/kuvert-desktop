{
  "name": "kuvert-desktop",
  "productName": "Kuvert",
  "version": "0.1.0",
  "private": true,
  "description": "Kuvert als Desktop-App – schlanke Hülle um die Kuvert-Weboberfläche",
  "homepage": "https://github.com/Man-in-Black/kuvert-desktop",
  "author": "Kuvert",
  "main": "main.js",
  "desktopName": "kuvert.desktop",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "de.kuvert.desktop",
    "productName": "Kuvert",
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "assets/*.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "protocols": [
      {
        "name": "E-Mail",
        "schemes": [
          "mailto"
        ]
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "executableName": "kuvert",
      "icon": "assets/icon.png",
      "category": "Network",
      "maintainer": "Kuvert",
      "synopsis": "E-Mail, Kalender, Kontakte und Chat",
      "mimeTypes": [
        "x-scheme-handler/mailto"
      ],
      "artifactName": "Kuvert-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Kuvert-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "assets/installer.nsh",
      "shortcutName": "Kuvert"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Kuvert-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Man-in-Black/kuvert-desktop.git"
  }
}
